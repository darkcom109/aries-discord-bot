DISCORD_TOKEN=your_discord_bot_token
OLLAMA_API_KEY=your_ollama_api_key
# Automatic backup when cloud usage/rate limits are reached or cloud is unavailable.
# Requires a running local Ollama instance and `ollama pull qwen3.5:2b` on the bot host.
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_LOCAL_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_LOCAL_MODEL=qwen3.5:2b
SEARXNG_SECRET=replace_with_a_random_secret

# Optional: TfL works anonymously without this key.
TFL_APP_KEY=

# Required for /server, /logs and /autonomy; autonomy stays off until /autonomy start.
ARIES_OWNER_ID=your_discord_user_id
# Change only if your Linux systemd service has a different name.
ARIES_SYSTEMD_UNIT=aries.service
